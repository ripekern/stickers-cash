{
  "name": "stickers-cash-pay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "db:local": "wrangler d1 execute stickers-cash-pay --local --file=schema.sql --config wrangler.toml",
    "db:remote": "wrangler d1 execute stickers-cash-pay --remote --file=schema.sql --config wrangler.toml",
    "address": "node scripts/address.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@scure/bip32": "^2.0.0",
    "cashaddrjs": "^0.4.4"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
